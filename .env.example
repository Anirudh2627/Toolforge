# Copy to .env and fill in ONLY what you need. The core project (environments,
# benchmark, verifier, tests, CPU evaluation) requires NO secrets at all.
#
# Optional — only used if you explicitly enable external teacher generation
# (Phase 3) or model publishing (Phase 6). Never hardcode these in code or
# notebooks; never commit the .env file.

# Hugging Face token: needed only for gated models or `hf push` publishing.
HF_TOKEN=

# Optional teacher-model APIs for trajectory generation (off by default).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Persistent artifact location (e.g. a Google Drive mount on Colab).
# TOOLFORGE_OUTPUT_DIR=/content/drive/MyDrive/toolforge
TOOLFORGE_OUTPUT_DIR=
